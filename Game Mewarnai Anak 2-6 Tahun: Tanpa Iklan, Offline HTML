        <!-- Sticker Selector (Visible when sticker tool active) -->
        <div id="sticker-container" style="display: none;">
          <div class="section-title">Pilih Stiker</div>
          <div class="palette-grid" id="sticker-grid">
            <button class="btn btn-accent sticker-opt active" data-sticker="⭐">⭐</button>
            <button class="btn btn-accent sticker-opt" data-sticker="❤️">❤️</button>
            <button class="btn btn-accent sticker-opt" data-sticker="👑">👑</button>
            <button class="btn btn-accent sticker-opt" data-sticker="🌸">🌸</button>
            <button class="btn btn-accent sticker-opt" data-sticker="🎵">🎵</button>
            <button class="btn btn-accent sticker-opt" data-sticker="🚀">🚀</button>
            <button class="btn btn-accent sticker-opt" data-sticker="🦄">🦄</button>
            <button class="btn btn-accent sticker-opt" data-sticker="🎈">🎈</button>
          </div>
